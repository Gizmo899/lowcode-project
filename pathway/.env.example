# Set a long, random value before running outside a local development machine.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# Optional overrides. Defaults are inside instance/.
# DATABASE_PATH=/absolute/path/to/job_tracker.sqlite
# CV_UPLOAD_FOLDER=/absolute/path/to/private_uploads/cv
# MAX_UPLOAD_BYTES=5242880
