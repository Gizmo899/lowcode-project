flowchart LR
    J[/(E1) Jobseeker/]
    A[/(E2) Career Adviser/]
    OP[/(E3) Server operator and OS scheduler/]

    subgraph TB1["TB1 — Browser / HTTPS boundary"]
      P1((P1 Authentication and account management))
      P2((P2 Profiles and adviser assignment))
      P3((P3 CV management and approval))
      P4((P4 Job application management))
    end

    subgraph TB2["TB2 — Application / data boundary"]
      D1[(D1 SQLite database)]
      D2[(D2 Private CV file storage)]
      P5((P5 Automation and notification processing))
    end

    subgraph TB3["TB3 — Role / ownership boundary"]
      R1[Jobseeker-owned records]
      R2[Assigned-adviser-only records]
    end

    subgraph TB4["TB4 — Scheduled-process boundary"]
      S1[Restricted OS scheduler identity]
    end

    J -->|Credentials and profile data| P1
    A -->|Credentials and profile data| P1
    P1 -->|Session and account result| J
    P1 -->|Session and account result| A
    J -->|Adviser choice and profile updates| P2
    A -->|Assigned jobseeker view request| P2
    P2 <--> D1
    J -->|CV upload| P3
    A -->|CV decision and comments| P3
    P3 <--> D1
    P3 <--> D2
    J -->|Application CRUD request| P4
    A -->|Read assigned applications| P4
    P4 <--> D1
    P2 --> R1
    P2 --> R2
    R1 -.->|Owner checks| P3
    R2 -.->|Assigned adviser checks| P3
    R1 -.->|Owner checks| P4
    R2 -.->|Assigned adviser read checks| P4
    OP -->|Scheduled invocation| S1
    S1 --> P5
    P5 <--> D1
    D1 -->|Digest and follow-up notifications| J
    D1 -->|CV review result| J
