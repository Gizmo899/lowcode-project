# Copy to .env and change SECRET_KEY before any non-demo use.
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///app.db
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_MB=5
# IANA name, e.g. Europe/Dublin. Controls "today", deadlines, digests, nudge times and the scheduler.
APP_TIMEZONE=UTC
NUDGE_DELAY_DAYS=7
AUTO_INIT_DB=true
# Only affects `python run.py`. For `flask run` or a WSGI server, run the jobs with
# `flask --app run.py run-scheduler` in exactly one separate process instead.
START_SCHEDULER=true
