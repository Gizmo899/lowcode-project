# Copy this file to .env (same folder as app.py) and fill in the value below.
# The app will not start without a real secret.
#
# Make one with:   python -c "import secrets; print(secrets.token_hex(32))"
# Paste the result after the equals sign. Keep it private and never commit .env.
FLASK_SECRET_KEY=fee3a61e962aaff8a912cb5690dfa9b9d0333d5cd403974c55c4fceebc2670ed

# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# Optional overrides. Defaults are inside instance/.
# DATABASE_PATH=/absolute/path/to/job_tracker.sqlite
# CV_UPLOAD_FOLDER=/absolute/path/to/private_uploads/cv
# MAX_UPLOAD_BYTES=5242880
